if (isset($pterodactyl) && $pterodactyl) {
?>

<div class="title_row">
    <h3><?php $this->_('Calagopus.manage.import_title'); ?></h3>
</div>
<?php
if (!empty($import_results)) {
?>
<div class="pad">
    <p><strong><?php $this->_(
        'Calagopus.manage.import_success',
        false,
