</div>
<?php
}

$num_rows = count(isset($pterodactyl_rows) ? $pterodactyl_rows : []);
if ($num_rows > 0) {
    // Build the list of Calagopus rows to import into
    $calagopus_row_options = ['' => $this->_('Calagopus.manage.import_skip_row', true)];
    foreach ((isset($module->rows) ? $module->rows : []) as $row) {
        $calagopus_row_options[$row->id] = (isset($row->meta->server_name) ? $row->meta->server_name : '')
            . ' (' . (isset($row->meta->host_name) ? $row->meta->host_name : '') . ')';
    }
?>
<div class="pad">
    <p><?php $this->_(
        'Calagopus.manage.import_description',
        false,
        (int)(isset($import_counts['packages']) ? $import_counts['packages'] : 0),
        (int)(isset($import_counts['services']) ? $import_counts['services'] : 0),
    ); ?></p>
</div>
<?php
    $this->Form->create(
        $this->base_uri . 'settings/company/modules/manage/' . (isset($module->id) ? $module->id : null) . '/',
        ['id' => 'calagopus_import_form'],
    );
    $this->Form->fieldHidden('import_action', 'pterodactyl');
?>
<div id="calagopus_import_result"></div>
<table class="table">
    <tr class="heading_row">
        <td><span><?php $this->_('Calagopus.manage.import_heading.name'); ?></span></td>
        <td><span><?php $this->_('Calagopus.manage.import_heading.host_name'); ?></span></td>
        <td class="last"><span><?php $this->_('Calagopus.manage.import_heading.target'); ?></span></td>
    </tr>
    <?php
    $i = 0;
    foreach ($pterodactyl_rows as $pterodactyl_row) {
    ?>
    <tr<?php echo ($i++ % 2 == 1) ? ' class="odd_row"' : ''; ?>>
        <td><?php echo isset($pterodactyl_row->meta->server_name)
            ? $this->Html->safe($pterodactyl_row->meta->server_name)
            : null; ?></td>
        <td><?php echo isset($pterodactyl_row->meta->host_name)
            ? $this->Html->safe($pterodactyl_row->meta->host_name)
            : null; ?></td>
        <td>
            <?php $this->Form->fieldSelect(
                'row_map[' . $pterodactyl_row->id . ']',
                $calagopus_row_options,
                (isset($vars->row_map[$pterodactyl_row->id]) ? $vars->row_map[$pterodactyl_row->id] : ''),
                ['id' => 'import_row_' . $pterodactyl_row->id],
            ); ?>
        </td>
    </tr>
    <?php } ?>
</table>
<div class="button_row">
    <a id="calagopus_import_btn" class="btn btn-primary float-right" href="#" data-confirm="<?php echo $this->Html->safe(
        $this->_('Calagopus.manage.import_confirm', true),
    ); ?>"><?php $this->_('Calagopus.manage.import_btn'); ?></a>
</div>
<?php
    $this->Form->end();
} else {
?>
<div class="empty_section">
    <div class="empty_box">
        <?php $this->_('Calagopus.manage.import_no_rows'); ?>
    </div>
</div>
<?php
}
}

$this->Widget->end();
?>

<script type="text/javascript">
    $(document).ready(function() {
        $('#manage_calagopus a.manage[rel]').blestaModalConfirm({base_url: '<?php echo $this->base_uri;?>', close: '<?php $this->_('AppController.modal.text_close');?>', submit: true});

        $('#calagopus_import_btn').on('click', function(e) {
            e.preventDefault();

            var $btn = $(this);
            if ($btn.hasClass('disabled')) {
                return;
            }
            if (!window.confirm($btn.data('confirm'))) {
                return;
            }

            var $form = $('#calagopus_import_form');
            var $result = $('#calagopus_import_result');

            $btn.addClass('disabled');
            $result.empty();

            $.ajax({
                type: 'POST',
                url: $form.attr('action'),
                data: $form.serialize(),
                dataType: 'json'
            }).done(function(response) {
                var html = '';

                if (response && response.success) {
                    html = '<div class="pad"><p><strong>' + $('<div>').text(response.success).html() + '</strong></p>';
                    if (response.notes && response.notes.length) {
                        html += '<ul>';
                        $.each(response.notes, function(i, note) {
                            html += '<li>' + $('<div>').text(note).html() + '</li>';
                        });
                        html += '</ul>';
                    }
                    html += '</div>';
                } else if (response && response.error) {
                    var errors = [].concat(response.error);
                    html = '<div class="pad"><ul>';
                    $.each(errors, function(i, err) {
                        html += '<li>' + $('<div>').text(err).html() + '</li>';
                    });
                    html += '</ul></div>';
                }

                $result.html(html);
            }).fail(function() {
                $result.html('<div class="pad"><p><strong><?php echo $this->Html->safe($this->_('Calagopus.manage.import_failed', true)); ?></strong></p></div>');
            }).always(function() {
                $btn.removeClass('disabled');
            });
        });
    });
</script>
